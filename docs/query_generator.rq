# Generated by OpenAI (incorrectly):
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?winner ?year WHERE {
    ?prize dbo:award dbr:Nobel_Prize_in_Physics ;
           dbo:year ?year ;
           dbo:laureate ?winner .           
    FILTER(?year > "2000"^^xsd:integer)
} ORDER BY ?year

# This works: ?prize dbo:award dbr:Nobel_Prize_in_Physics .
